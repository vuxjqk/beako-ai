# Copy to .env.local

# FastAPI backend that /api/* is proxied to (see next.config.ts)
BACKEND_URL=http://localhost:8000

# Google OAuth Client ID (same value as GOOGLE_CLIENT_ID in the backend .env).
# In Google Cloud Console add http://localhost:3000 to "Authorized JavaScript origins".
# Leave empty to disable the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
