POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host "db" is the docker-compose service name
DATABASE_URL=postgresql+psycopg://<user>:<password>@db:5432/<db>

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false
# /api/auth because the Next.js frontend proxies the API under /api
REFRESH_COOKIE_PATH=/api/auth

# OAuth 2.0 Client ID from Google Cloud Console (same one the frontend uses);
# comma-separate several (e.g. web,android). Empty = POST /auth/google disabled.
GOOGLE_CLIENT_ID=

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Wrong passwords per email before its logins are refused for LOGIN_LOCK_MINUTES
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_MINUTES=15

# Local dev: the mailpit service (inbox at http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Beako <no-reply@beako.com>
# starttls (port 587) | ssl (port 465) | none (local dev server)
SMTP_SECURITY=none
# Example for Gmail (needs an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=<app-password>
# SMTP_SECURITY=starttls

# Uploaded files (avatars) are stored locally for now
UPLOAD_DIR=uploads
AVATAR_MAX_BYTES=2097152

# Question answering guardrails. Per-user limits (admins exempt); days start at midnight in QA_TIMEZONE
QA_USER_PER_MINUTE=5
QA_USER_PER_DAY=100
QA_USER_DAILY_TOKENS=300000
QA_USER_MAX_CONCURRENT=1
# System-wide spend per day in USD (0 = no cap): from QA_DEGRADE_AT x budget only the simple path
# runs, at the budget questions are refused until the next day
QA_DAILY_BUDGET_USD=5
QA_DEGRADE_AT=0.8
QA_TIMEZONE=UTC
# LLM_MODEL price in USD per million tokens (input / output), for cost estimates
LLM_PRICE_INPUT_PER_MTOK=0.5
LLM_PRICE_OUTPUT_PER_MTOK=3

# Level of the app's own logs (one line per question, agent steps): DEBUG | INFO | WARNING
LOG_LEVEL=INFO
